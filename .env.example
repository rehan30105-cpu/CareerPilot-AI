# Application
APP_NAME=CareerPilot AI
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security (CHANGE THESE IN PRODUCTION — never commit real values)
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

# AI / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Vector store (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
